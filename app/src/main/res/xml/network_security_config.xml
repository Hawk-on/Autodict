<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blokkerer klartekst-HTTP som standard, og det skal han. Men ein lokal modell
  (Ollama, LM Studio, llama.cpp sin server) køyrer typisk på http://192.168.x.x:11434
  utan sertifikat. Utan unntaket under ville "peik appen på min eigen Ollama" berre feile.

  Unntaket er avgrensa til private adresseområde: alt ut på internett må framleis vere
  HTTPS. Det er ei reell oppmjuking, men berre mot maskiner på ditt eige nett.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.0.0/8</domain>
        <domain includeSubdomains="false">172.16.0.0/12</domain>
        <domain includeSubdomains="false">192.168.0.0/16</domain>
    </domain-config>
</network-security-config>
